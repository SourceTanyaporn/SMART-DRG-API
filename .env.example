APP_NAME=Whisper API
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_NUM_WORKERS=1
WHISPER_BEAM_SIZE=3
WHISPER_VAD_FILTER=true
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_REPETITION_PENALTY=1.15
WHISPER_NO_REPEAT_NGRAM_SIZE=3
WHISPER_INITIAL_PROMPT=การสนทนาทางการแพทย์ ซักประวัติคนไข้และตรวจร่างกาย ภาวะดื้ออินซูลิน Acanthosis nigricans อาแคนโทซิส นิกริแคนส์ เบาหวาน ความดัน ไขมันในเลือด รอยปื้นดำ หลังคอ รักแร้ ข้อพับ เซลล์ ผลตรวจเลือด คอเลสเตอรอล ไตรกลีเซอไรด์ น้ำตาลสะสม HbA1c
TRANSCRIPT_POST_PROCESS=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
UPLOAD_DIR=/tmp/whisper-uploads
MAX_UPLOAD_MB=200

